{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u957f\u4ec0\u4e48\u6837\uff1f\u62c6\u89e3\u5927\u7eff\u672c\u5236\u53d1\u6d41\u7a0b\u4e0e\u4ea7\u6743\u7528\u9014","text":"<p>\u5728\u6c7d\u8f66\u5708\u91cc\uff0c\u6709\u4e00\u4e2a\u6bcf\u4e00\u4e2a\u8f66\u4e3b\u90fd\u7ed5\u4e0d\u5f00\u7684\u201c\u660e\u661f\u8bc1\u4ef6\u201d\u2014\u2014\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u3002\u56e0\u4e3a\u5b83\u7684\u5c01\u9762\u91c7\u7528\u4e86\u6807\u5fd7\u6027\u7684\u6df1\u7eff\u8272\u786c\u8d28\u7eb8\u5f20\uff0c\u56e0\u6b64\u5728\u6c11\u95f4\u5b83\u88ab\u5f62\u8c61\u5730\u79f0\u4e4b\u4e3a\u201c\u5927\u7eff\u672c\u201d\u3002</p> <p></p> <p>\u5982\u679c\u8bf4\u673a\u52a8\u8f66\u884c\u9a76\u8bc1\u662f\u6c7d\u8f66\u7684\u201c\u8eab\u4efd\u8bc1\u201d\uff08\u5fc5\u987b\u968f\u8f66\u643a\u5e26\u4ee5\u5907\u4ea4\u8b66\u67e5\u9a8c\uff09\uff0c\u90a3\u4e48\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u5c31\u662f\u6c7d\u8f66\u7684\u201c\u6237\u53e3\u672c\u201d\u548c\u201c\u623f\u4ea7\u8bc1\u201d\u3002\u5b83\u4e0d\u4ec5\u662f\u6cd5\u5f8b\u5c42\u9762\u4e0a\u8f66\u8f86\u6240\u6709\u6743\u7684\u552f\u4e00\u5408\u6cd5\u8bc1\u660e\uff0c\u66f4\u662f\u8f66\u8f86\u540e\u7eed\u9762\u4e34\u8fc7\u6237\u3001\u8f6c\u7c4d\u3001\u62b5\u62bc\u3001\u6ce8\u9500\u7b49\u6240\u6709\u751f\u547d\u5468\u671f\u53d8\u52a8\u65f6\uff0c\u4e0d\u53ef\u6216\u7f3a\u7684\u201c\u7ec8\u6781\u6838\u5fc3\u6863\u6848\u201d\u3002</p> <p>\u7531\u4e8e\u5728\u65e5\u5e38\u7528\u8f66\u4e2d\u5927\u7eff\u672c\u4e0d\u9700\u8981\u968f\u8f66\u643a\u5e26\uff0c\u8bb8\u591a\u65b0\u624b\u8f66\u4e3b\u5728\u63d0\u8f66\u4e0a\u724c\u540e\u4fbf\u5c06\u5176\u675f\u4e4b\u9ad8\u9601\uff0c\u751a\u81f3\u4ece\u672a\u4ed4\u7ec6\u7ffb\u5f00\u8fc7\u5b83\u3002\u672c\u6587\u5c06\u4e3a\u60a8\u8be6\u7ec6\u56fe\u89e3\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u7684\u5916\u89c2\u7248\u5f0f\u3001\u62c6\u89e3\u5b98\u65b9\u5236\u53d1\u6d41\u7a0b\uff0c\u5e76\u76d8\u70b9\u5b83\u5728\u73b0\u5b9e\u751f\u6d3b\u4e2d\u7684\u51e0\u5927\u6838\u5fc3\u6240\u6709\u6743\u7528\u9014\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u957f\u4ec0\u4e48\u6837\uff1f\u62c6\u89e3\u5927\u7eff\u672c\u5236\u53d1\u6d41\u7a0b\u4e0e\u4ea7\u6743\u7528\u9014","text":"<p>\u6839\u636e\u8f66\u8f86\u767b\u8bb0\u4e1a\u52a1\u7684\u6838\u5fc3\u641c\u7d22\u70ed\u5ea6\u6765\u770b\uff0c\u8bb8\u591a\u4eba\u5bf9\u201c\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u9632\u4f2a\u201d\u4ee5\u53ca\u201c\u5927\u7eff\u672c\u5185\u90e8\u683c\u5f0f\u201d\u975e\u5e38\u5173\u5fc3\u3002\u6807\u51c6\u7684\u5b98\u65b9\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u662f\u7531\u516c\u5b89\u90e8\u4ea4\u901a\u7ba1\u7406\u5c40\u7edf\u4e00\u76d1\u5236\uff0c\u5177\u5907\u6781\u9ad8\u7684\u9632\u4f2a\u5de5\u827a\u548c\u56fa\u5b9a\u7248\u5f0f\uff1a</p>"},{"location":"#1","title":"1. \u5c01\u9762\u4e0e\u6750\u8d28\u7279\u5f81","text":"<ul> <li>\u5916\u89c2\u989c\u8272\uff1a \u5c01\u9762\u4e3a\u6df1\u7eff\u8272\uff0c\u8d28\u5730\u4e3a\u5e26\u6709\u72ec\u7279\u7eb9\u7406\u7684\u7279\u79cd\u786c\u9762\u7eb8\u5f20\u3002</li> <li>\u6587\u5b57\u6807\u8bc6\uff1a \u5c01\u9762\u6b63\u4e0a\u65b9\u5370\u6709\u70eb\u91d1\u7684\u201c\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u201d\u5b57\u6837\uff0c\u6b63\u4e2d\u4e3a\u9192\u76ee\u7684\u70eb\u91d1\u201c\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u201d\u6807\u9898\u3002</li> <li>\u5370\u5236\u7279\u5f81\uff1a \u5c01\u9762\u8fb9\u7f18\u53ca\u5185\u90e8\u5e26\u6709\u7cbe\u7ec6\u7684\u9632\u4f2a\u82b1\u7eb9\uff0c\u624b\u6478\u6709\u660e\u663e\u7684\u51f9\u51f8\u89e6\u611f\u3002</li> </ul>"},{"location":"#2","title":"2. \u5185\u9875\u7ed3\u6784\u4e0e\u6838\u5fc3\u4fe1\u606f","text":"<p>\u5927\u7eff\u672c\u91c7\u7528\u591a\u9875\u8054\u9875\u8bbe\u8ba1\uff0c\u5185\u90e8\u4e3b\u8981\u5212\u5206\u4e3a\u4ee5\u4e0b\u6838\u5fc3\u677f\u5757\uff1a * \u7b2c\u4e00\u9875\uff08\u767b\u8bb0\u680f\uff09\uff1a \u8fd9\u662f\u5927\u7eff\u672c\u7684\u201c\u5fc3\u810f\u201d\u3002\u4e0a\u9762\u6253\u5370\u7740\u7531\u8f66\u7ba1\u6240\u5236\u8bc1\u7cfb\u7edf\u751f\u6210\u7684\u8f66\u8f86\u552f\u4e00\u7f16\u53f7\uff08\u5373\u767b\u8bb0\u8bc1\u4e66\u7f16\u53f7\uff09\u3001\u673a\u52a8\u8f66\u6240\u6709\u4eba\u59d3\u540d/\u8eab\u4efd\u8bc1\u660e\u540d\u79f0\u3001\u8f66\u8f86\u54c1\u724c\u578b\u53f7\u3001\u8f66\u8f86\u8bc6\u522b\u4ee3\u53f7\uff08VIN\u7801/\u8f66\u67b6\u53f7\uff09\u3001\u53d1\u52a8\u673a\u53f7\u3001\u8f66\u8f86\u989c\u8272\u3001\u4f7f\u7528\u6027\u8d28\uff08\u5982\u975e\u8425\u8fd0\uff09\u4ee5\u53ca\u521d\u6b21\u767b\u8bb0\u65e5\u671f\u3002 * \u7b2c\u4e8c\u9875\u53ca\u540e\u7eed\u9875\uff08\u767b\u8bb0\u680f/\u53d8\u66f4\u680f\uff09\uff1a \u91c7\u7528\u8868\u683c\u5f62\u5f0f\u5448\u73b0\u3002\u7528\u4e8e\u8bb0\u5f55\u8fd9\u8f86\u8f66\u5728\u672a\u6765\u7684\u6240\u6709\u201c\u4e00\u751f\u8f68\u8ff9\u201d\uff0c\u5305\u62ec\u62b5\u62bc\u767b\u8bb0\u3001\u89e3\u9664\u62b5\u62bc\u3001\u8f6c\u79fb\u767b\u8bb0\uff08\u8fc7\u6237\uff09\u3001\u53d8\u66f4\u767b\u8bb0\uff08\u5982\u6539\u88c5\u3001\u6362\u989c\u8272\u3001\u8fc1\u51fa\u672c\u5730\uff09\u7b49\u3002\u6bcf\u4e00\u6b21\u53d8\u52a8\uff0c\u8f66\u7ba1\u6240\u90fd\u4f1a\u5728\u6b64\u5904\u6253\u5370\u6700\u65b0\u7684\u884c\u653f\u7b7e\u6ce8\u5e76\u52a0\u76d6\u4e1a\u52a1\u4e13\u7528\u7ae0\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u8f66\u8f86\u767b\u8bb0\u8bc1\u4e66\u5236\u53d1\u6d41\u7a0b\uff1a\u4ece\u4e0a\u724c\u5230\u5b98\u65b9\u51fa\u8bc1\u7684\u5185\u90e8\u6d41\u6c34\u7ebf","text":"<p>\u4e0d\u5c11\u8f66\u4e3b\u5728\u8d2d\u4e70\u65b0\u8f66\u540e\uff0c\u90fd\u4f1a\u63d0\u51fa\u8fd9\u6837\u7684\u7591\u95ee\uff1a\u201c\u65b0\u8f66\u4e0a\u724c\u5f53\u5929\u80fd\u4e0d\u80fd\u62ff\u5230\u5927\u7eff\u672c\uff1f\u201d\u201c\u5b98\u65b9\u5236\u4f5c\u5927\u7eff\u672c\u9700\u8981\u7ecf\u8fc7\u54ea\u4e9b\u5ba1\u6279\u6b65\u9aa4\uff1f\u201d</p> <p>\u4e8b\u5b9e\u4e0a\uff0c\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u7684\u201c\u5236\u53d1\u201d\u662f\u4e00\u9879\u6781\u4e3a\u4e25\u8c28\u7684\u884c\u653f\u5ba1\u6279\u4e0e\u9632\u4f2a\u6253\u5370\u8fc7\u7a0b\u3002\u4e00\u8f86\u65b0\u8f66\u4ece\u63d0\u4ea4\u7533\u8bf7\u5230\u5b98\u65b9\u5b8c\u6210\u8bc1\u4e66\u5236\u4f5c\uff0c\u5fc5\u987b\u8d70\u5b8c\u4ee5\u4e0b\u56db\u4e2a\u673a\u52a8\u8f66\u5185\u7f51\u6d41\u6c34\u7ebf\uff1a</p>"},{"location":"#_4","title":"\ud83c\udfc1 \u6b65\u9aa4\u4e00\uff1a\u65b0\u8f66\u67e5\u9a8c\u4e0e\u4fe1\u606f\u91c7\u96c6","text":"<p>\u5728\u4e0a\u724c\u73b0\u573a\uff0c\u8f66\u7ba1\u6240\u68c0\u9a8c\u6c11\u8b66\u4f1a\u5bf9\u65b0\u8f66\u8fdb\u884c\u5b9e\u8f66\u67e5\u9a8c\u3002\u6838\u5bf9\u8f66\u67b6\u53f7\u3001\u53d1\u52a8\u673a\u53f7\u662f\u5426\u4e0e\u51fa\u5382\u5408\u683c\u8bc1\u4e00\u81f4\uff0c\u62cd\u6444\u8f66\u8f86\u6807\u51c6\u7167\u7247\uff0c\u5e76\u5c06\u6570\u636e\u5f55\u5165\u516c\u5b89\u4ea4\u901a\u7ba1\u7406\u4fe1\u606f\u7cfb\u7edf\u3002</p>"},{"location":"#_5","title":"\ud83c\udfc1 \u6b65\u9aa4\u4e8c\uff1a\u8d44\u6599\u5ba1\u6838\u4e0e\u7cfb\u7edf\u786e\u6743","text":"<p>\u7a97\u53e3\u53d7\u7406\u4eba\u5458\u5bf9\u8f66\u4e3b\u7684\u8eab\u4efd\u8bc1\u660e\u3001\u8d2d\u623f\u53d1\u7968\uff08\u673a\u52a8\u8f66\u9500\u552e\u7edf\u4e00\u53d1\u7968\uff09\u3001\u8d2d\u7f6e\u7a0e\u5b8c\u7a0e\u51ed\u8bc1\u3001\u673a\u52a8\u8f66\u4ea4\u901a\u4e8b\u6545\u8d23\u4efb\u5f3a\u5236\u4fdd\u9669\uff08\u4ea4\u5f3a\u9669\uff09\u8fdb\u884c\u6838\u9a8c\u3002\u5ba1\u6838\u901a\u8fc7\u540e\uff0c\u7cfb\u7edf\u4f1a\u6b63\u5f0f\u786e\u8ba4\u8f66\u8f86\u7684\u6240\u6709\u6743\u5f52\u5c5e\u3002</p>"},{"location":"#_6","title":"\ud83c\udfc1 \u6b65\u9aa4\u4e09\uff1a\u5b98\u65b9\u7f2e\u5370\u4e0e\u8bc1\u4e66\u5236\u4f5c","text":"<p>\u5f53\u9009\u53f7\u5b8c\u6210\u540e\uff0c\u8f66\u7ba1\u6240\u5236\u8bc1\u673a\u623f\u7684\u4e13\u7528\u9ad8\u7cbe\u6253\u5370\u673a\u4f1a\u542f\u52a8\u3002\u5927\u7eff\u672c\u7684\u5236\u4f5c\u5728\u7cfb\u7edf\u5185\u90e8\u88ab\u79f0\u4e3a\u201c\u7f2e\u5370\u201d\u3002 \u5236\u8bc1\u8bbe\u5907\u4f1a\u5c06\u91c7\u96c6\u5230\u7684\u6570\u5341\u9879\u8f66\u8f86\u6280\u672f\u53c2\u6570\u548c\u6240\u6709\u4eba\u4fe1\u606f\uff0c\u7cbe\u51c6\u3001\u9632\u4f2a\u5730\u6253\u5370\u5728\u7a7a\u767d\u767b\u8bb0\u8bc1\u4e66\u7684\u5bf9\u5e94\u680f\u76ee\u5185\u3002</p>"},{"location":"#_7","title":"\ud83c\udfc1 \u6b65\u9aa4\u56db\uff1a\u52a0\u76d6\u516c\u7ae0\u4e0e\u8bc1\u4ef6\u6838\u53d1","text":"<p>\u5236\u4f5c\u5b8c\u6210\u7684\u767b\u8bb0\u8bc1\u4e66\uff0c\u5fc5\u987b\u52a0\u76d6\u5404\u7701/\u5e02\u516c\u5b89\u5c40\u4ea4\u901a\u8b66\u5bdf\u652f\u961f\u673a\u52a8\u8f66\u4e1a\u52a1\u4e13\u7528\u7ae0\uff08\u901a\u5e38\u4e3a\u6570\u5b57\u5316\u9632\u4f2a\u5370\u7ae0\u6216\u5b9e\u4f53\u7ea2\u7ae0\uff09\uff0c\u968f\u540e\u8fde\u540c\u884c\u9a76\u8bc1\u3001\u673a\u52a8\u8f66\u53f7\u724c\u4e00\u540c\u6838\u53d1\u7ed9\u8f66\u4e3b\u3002\u5728\u5e38\u89c4\u6d41\u7a0b\u4e0b\uff0c\u6574\u4e2a\u5b98\u65b9\u5236\u4f5c\u5468\u671f\u5728\u7a97\u53e3\u53d7\u7406\u540e\u53ea\u97001-2\u4e2a\u5c0f\u65f6\uff0c\u7edd\u5927\u591a\u6570\u57ce\u5e02\u5747\u53ef\u5b9e\u73b0\u201c\u73b0\u573a\u4e0a\u724c\u3001\u5f53\u5929\u62ff\u8bc1\u201d\u3002</p>"},{"location":"#_8","title":"\u4e09\u3001 \u62c6\u89e3\u5927\u7eff\u672c\u7684\u6838\u5fc3\u7528\u9014\uff1a\u54ea\u4e9b\u73b0\u5b9e\u529e\u4e8b\u573a\u666f\u5fc5\u987b\u51fa\u793a\u5b83\uff1f","text":"<p>\u5728\u5404\u5927\u641c\u7d22\u8d8b\u52bf\u4e2d\uff0c\u5173\u4e8e\u201c\u5927\u7eff\u672c\u6709\u4ec0\u4e48\u7528\u201d\u4ee5\u53ca\u201c\u6ca1\u6709\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u80fd\u8fc7\u6237\u5417\u201d\u7684\u54a8\u8be2\u91cf\u4e00\u76f4\u5c45\u9ad8\u4e0d\u4e0b\u3002\u5927\u7eff\u672c\u7edd\u4e0d\u662f\u4e00\u5f20\u5e9f\u7eb8\uff0c\u5728\u4ee5\u4e0b\u4e09\u5927\u73b0\u5b9e\u573a\u666f\u4e2d\uff0c\u5b83\u662f\u51b3\u5b9a\u4e1a\u52a1\u6210\u8d25\u7684\u552f\u4e00\u6cd5\u5b9a\u51ed\u8bc1\uff1a</p>"},{"location":"#1_1","title":"1. \u4e8c\u624b\u623f/\u4e8c\u624b\u8f66\u8d44\u4ea7\u4ea4\u6613\uff08\u8f66\u8f86\u8f6c\u79fb\u767b\u8bb0\uff09","text":"<p>\u5f53\u4f60\u6253\u7b97\u5c06\u8f66\u8f86\u5356\u7ed9\u4ed6\u4eba\u6216\u53d8\u5356\u7ed9\u4e8c\u624b\u8f66\u5546\u65f6\uff0c\u5fc5\u987b\u8fdb\u884c\u8f66\u8f86\u8fc7\u6237\u3002\u5728\u8f66\u7ba1\u6240\u529e\u7406\u8f6c\u79fb\u767b\u8bb0\u65f6\uff0c\u53cc\u65b9\u4ec5\u51fa\u793a\u884c\u9a76\u8bc1\u662f\u65e0\u6cd5\u529e\u7406\u7684\u3002\u4e70\u5356\u53cc\u65b9\u5fc5\u987b\u5171\u540c\u63d0\u4f9b\u5927\u7eff\u672c\u3002 \u5b98\u65b9\u9700\u8981\u5728\u767b\u8bb0\u8bc1\u4e66\u7684\u53d8\u66f4\u680f\u5185\uff0c\u62b9\u53bb\u539f\u8f66\u4e3b\u4fe1\u606f\uff0c\u6253\u5370\u4e0a\u65b0\u8f66\u4e3b\u7684\u59d3\u540d\u53ca\u8fc7\u6237\u65f6\u95f4\uff0c\u4ee5\u6b64\u5b8c\u6210\u6cd5\u5b9a\u4ea7\u6743\u7684\u8f6c\u79fb\u3002</p>"},{"location":"#2_1","title":"2. \u8f66\u8f86\u62b5\u62bc\u8d37\u6b3e\u4e0e\u8d44\u91d1\u878d\u901a","text":"<p>\u5728\u65e5\u5e38\u91d1\u878d\u501f\u8d37\u4e2d\uff0c\u201c\u6c7d\u8f66\u62b5\u62bc\u8d37\u6b3e\u5927\u7eff\u672c\u201d\u662f\u4e00\u4e2a\u9ad8\u9891\u8bcd\u6c47\u3002\u5f53\u8f66\u4e3b\u7531\u4e8e\u8d44\u91d1\u5468\u8f6c\u9700\u8981\uff0c\u5411\u94f6\u884c\u6216\u5408\u89c4\u91d1\u878d\u673a\u6784\u7533\u8bf7\u6c7d\u8f66\u6d88\u8d39\u8d37\u6b3e\u6216\u62b5\u62bc\u8d37\u6b3e\u65f6\uff0c\u91d1\u878d\u673a\u6784\u4e3a\u4e86\u4fdd\u969c\u81ea\u8eab\u503a\u6743\uff0c\u4f1a\u8981\u6c42\u8f66\u4e3b\u5c06\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u8d28\u62bc/\u62b5\u62bc\u7ed9\u673a\u6784\u3002 \u53cc\u65b9\u9700\u5171\u540c\u524d\u5f80\u8f66\u7ba1\u6240\u529e\u7406\u201c\u62b5\u62bc\u767b\u8bb0\u201d\uff0c\u8f66\u7ba1\u6240\u4f1a\u5728\u5927\u7eff\u672c\u7684\u53d8\u66f4\u680f\u660e\u786e\u6253\u5370\uff1a\u201c\u67d0\u5e74\u67d0\u6708\u67d0\u65e5\uff0c\u62b5\u62bc\u7ed9\u67d0\u67d0\u94f6\u884c\u201d\u3002\u5728\u8d37\u6b3e\u672a\u5168\u989d\u7ed3\u6e05\u3001\u672a\u529e\u7406\u201c\u89e3\u9664\u62b5\u62bc\u767b\u8bb0\u201d\u4e4b\u524d\uff0c\u8be5\u8f66\u8f86\u5728\u7cfb\u7edf\u5185\u5c06\u88ab\u9501\u5b9a\uff0c\u65e0\u6cd5\u8fdb\u884c\u4efb\u4f55\u8fc7\u6237\u548c\u4e70\u5356\u3002</p>"},{"location":"#3","title":"3. \u8f66\u8f86\u91cd\u5927\u53d8\u66f4\u767b\u8bb0","text":"<p>\u5982\u679c\u8f66\u4e3b\u5bf9\u8f66\u8f86\u8fdb\u884c\u4e86\u5408\u6cd5\u8303\u56f4\u5185\u7684\u6539\u88c5\uff08\u5982\u66f4\u6539\u8f66\u8eab\u989c\u8272\u3001\u66f4\u6362\u53d1\u52a8\u673a\u3001\u52a0\u88c5\u884c\u674e\u67b6\u7b49\uff09\uff0c\u6216\u8005\u56e0\u4e3a\u5de5\u4f5c\u53d8\u52a8\u9700\u8981\u5c06\u8f66\u8f86\u7684\u6237\u7c4d\u5730\u8fc1\u5f80\u5916\u7701\uff08\u8f6c\u7c4d\uff09\u3002\u5728\u524d\u5f80\u8f66\u7ba1\u6240\u7533\u8bf7\u53d8\u66f4\u65f6\uff0c\u5fc5\u987b\u63d0\u4ea4\u5927\u7eff\u672c\uff0c\u7531\u5b98\u65b9\u5728\u53d8\u66f4\u680f\u5185\u5f55\u5165\u6700\u65b0\u7684\u6539\u88c5\u6216\u8fc1\u51fa\u7b7e\u6ce8\u3002</p>"},{"location":"#_9","title":"\u56db\u3001 \u5ef6\u4f38\u6307\u5357\uff1a\u5927\u7eff\u672c\u4e0d\u614e\u9057\u5931\u4e86\u8be5\u5982\u4f55\u8865\u529e\uff1f","text":"<p>\u7531\u4e8e\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u4e0d\u9700\u8981\u968f\u8f66\u643a\u5e26\uff0c\u5f88\u591a\u8f66\u4e3b\u5728\u642c\u5bb6\u6216\u957f\u671f\u4e0d\u7528\u540e\uff0c\u7ecf\u5e38\u53d1\u751f\u627e\u4e0d\u5230\u7684\u60c5\u51b5\u3002\u5982\u679c\u5927\u7eff\u672c\u4e22\u5931\uff0c\u5207\u52ff\u901a\u8fc7\u975e\u6b63\u89c4\u6e20\u9053\u79c1\u81ea\u5c1d\u8bd5\u4eff\u5236\uff0c\u8fd9\u662f\u4e25\u91cd\u7684\u8fdd\u6cd5\u884c\u4e3a\u3002\u6211\u56fd\u5bf9\u5927\u7eff\u672c\u8bbe\u6709\u975e\u5e38\u4fbf\u6377\u7684\u5b98\u65b9\u8865\u529e\u673a\u5236\uff1a</p> <ul> <li>\u529e\u7406\u5730\u70b9\uff1a \u673a\u52a8\u8f66\u6240\u6709\u4eba\u9700\u643a\u5e26\u5c45\u6c11\u8eab\u4efd\u8bc1\u539f\u4ef6\uff0c\u5c06\u8f66\u8f86\u5f00\u81f3\u8f66\u8f86\u6237\u7c4d\u767b\u8bb0\u5730\u7684\u8f66\u7ba1\u6240\u6216\u6307\u5b9a\u7684\u673a\u52a8\u8f66\u767b\u8bb0\u670d\u52a1\u7ad9\u3002</li> <li>\u57fa\u672c\u6d41\u7a0b\uff1a \u73b0\u573a\u4f1a\u5b89\u6392\u5bf9\u8f66\u8f86\u8fdb\u884c\u91cd\u65b0\u67e5\u9a8c\uff08\u62d3\u5370\u8f66\u67b6\u53f7\u3001\u62cd\u7167\uff09\uff0c\u8f66\u4e3b\u586b\u5199\u300a\u673a\u52a8\u8f66\u724c\u8bc1\u7533\u8bf7\u8868\u300b\u3002\u8f66\u7ba1\u6240\u5185\u90e8\u7cfb\u7edf\u6838\u9a8c\u65e0\u8bef\u540e\uff0c\u4f1a\u91cd\u65b0\u542f\u52a8\u5236\u8bc1\u7a0b\u5e8f\uff0c\u5f53\u573a\u4e3a\u4f60\u91cd\u65b0\u5236\u4f5c\u5e76\u6838\u53d1\u4e00\u672c\u5168\u65b0\u7684\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\uff0c\u539f\u4e22\u5931\u7684\u8bc1\u4e66\u968f\u5373\u5728\u7cfb\u7edf\u5185\u5ba3\u544a\u4f5c\u5e9f\u3002</li> </ul> <p>\u603b\u7ed3\uff1a \u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u4f5c\u4e3a\u8f66\u8f86\u7684\u7ec8\u6781\u4ea7\u6743\u8f7d\u4f53\uff0c\u627f\u8f7d\u7740\u786e\u6743\u3001\u4ea4\u6613\u3001\u62b5\u62bc\u7b49\u591a\u91cd\u6cd5\u5f8b\u5c5e\u6027\u3002\u4e86\u89e3\u5b83\u7684\u5916\u89c2\u7279\u5f81\u3001\u660e\u767d\u5b83\u7684\u5b98\u65b9\u5236\u53d1\u6d41\u7a0b\uff0c\u5e76\u505a\u5230\u59a5\u5584\u4fdd\u7ba1\uff0c\u624d\u80fd\u5728\u672a\u6765\u7684\u6c7d\u8f66\u4e70\u5356\u548c\u91d1\u878d\u751f\u6d3b\u4e2d\u6e38\u5203\u6709\u4f59\uff0c\u5207\u5b9e\u4fdd\u969c\u4e2a\u4eba\u7684\u5927\u989d\u8d22\u4ea7\u5b89\u5168\u3002</p>"}]}